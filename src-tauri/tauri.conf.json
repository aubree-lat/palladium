{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Palladium",
  "version": "0.1.0",
  "identifier": "dev.palladium.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Discord client powered by Tauri",
    "longDescription": "A lightweight Discord client that uses the system webview via Tauri instead of bundling Electron, with optional Vencord or Equicord client mods and native Discord Rich Presence support.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
